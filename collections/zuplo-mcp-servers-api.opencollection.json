{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zuplo Developer API Keys - Buckets MCP Servers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "MCP Servers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Docs MCP Server",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://dev.zuplo.com/mcp/docs"
          },
          "docs": "The Zuplo Documentation MCP server"
        }
      ]
    }
  ],
  "bundled": true
}