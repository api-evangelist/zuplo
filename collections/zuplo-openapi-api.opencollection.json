{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zuplo Developer API Keys - Buckets Openapi API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Openapi",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenAPI Specification",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dev.zuplo.com/openapi"
          },
          "docs": "Returns the OpenAPI V3 spec for Zuplo's Developer API"
        }
      ]
    }
  ],
  "bundled": true
}